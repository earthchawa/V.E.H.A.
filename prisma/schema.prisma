// NKRAFA AI Classroom — data model
// Phase 1: accounts, terms, courses, course offerings, enrollment, materials, audit log.
// Phase 2: assignments, submissions, similarity checking.
// Phase 3: gradebook (categories, items, grades, grade scale).
// Phase 4: online quizzes (questions, attempts, answers, integrity events).
// Organisation: divisions (กองวิชา) → departments (ภาควิชา) → courses; academy-wide exam settings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum EnrollmentRole {
  STUDENT
  INSTRUCTOR
}

enum MaterialType {
  FILE
  LINK
}

/// When cadets may see the similarity report for their own submission.
enum ReportVisibility {
  IMMEDIATE
  AFTER_DUE
  HIDDEN
}

model User {
  id                    String    @id @default(cuid())
  /// Student ID / staff ID — what people type to log in.
  username              String    @unique
  fullName              String
  /// Optional; required for self-service "forgot password".
  email                 String?   @unique
  role                  Role      @default(STUDENT)
  passwordHash          String
  /// True for initial and admin-reset passwords: user must set their own on next login.
  mustChangePassword    Boolean   @default(true)
  /// A temporary password stops working after this time.
  tempPasswordExpiresAt DateTime?
  failedLoginCount      Int       @default(0)
  lockedUntil           DateTime?
  isActive              Boolean   @default(true)
  /// Home department (cadets: programme; staff: affiliation). Optional.
  departmentId          String?
  department            Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  lastLoginAt           DateTime?
  passwordChangedAt     DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  sessions    Session[]
  resetTokens PasswordResetToken[]
  enrollments Enrollment[]
  materials   Material[]
  auditLogs   AuditLog[]
  assignments Assignment[]
  submissions Submission[]
  grades      Grade[]
  quizzes     Quiz[]
  attempts    QuizAttempt[]
}

model Session {
  id        String   @id @default(cuid())
  /// SHA-256 of the cookie token; the raw token is never stored.
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Term {
  id           String    @id @default(cuid())
  /// Buddhist-era academic year, e.g. 2569.
  academicYear Int
  /// 1, 2 or 3 (summer).
  semester     Int
  startDate    DateTime?
  endDate      DateTime?
  isCurrent    Boolean   @default(false)
  createdAt    DateTime  @default(now())

  offerings CourseOffering[]

  @@unique([academicYear, semester])
}

model Course {
  id          String   @id @default(cuid())
  /// e.g. CS201
  code        String   @unique
  title       String
  titleTh     String?
  credits     Int?
  description String?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  offerings CourseOffering[]
}

/// A course taught in a specific term (and section).
model CourseOffering {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  termId    String
  term      Term     @relation(fields: [termId], references: [id], onDelete: Restrict)
  section   String   @default("1")
  createdAt DateTime @default(now())

  enrollments Enrollment[]
  materials   Material[]
  assignments Assignment[]
  gradeCategories GradeCategory[]
  gradeItems      GradeItem[]
  quizzes         Quiz[]
  /// [{ letter, min }] sorted by min, high → low. Null = academy default (A ≥ 80 … F).
  gradeScale          Json?
  /// Whether cadets see their running total and letter grade (from released items).
  showTotalToStudents Boolean @default(true)

  @@unique([courseId, termId, section])
  @@index([termId])
}

model Enrollment {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  offeringId String
  offering   CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  role       EnrollmentRole @default(STUDENT)
  createdAt  DateTime       @default(now())

  @@unique([userId, offeringId])
  @@index([offeringId])
}

model Material {
  id          String         @id @default(cuid())
  offeringId  String
  offering    CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  title       String
  description String?
  /// Optional week number for grouping.
  week        Int?
  type        MaterialType
  // FILE
  fileName    String?
  storageKey  String?
  mimeType    String?
  sizeBytes   Int?
  // LINK
  url         String?
  isPublished Boolean        @default(true)
  createdById String
  createdBy   User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([offeringId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  details    Json?
  ip         String?
  /// Course section the entry concerns (resolved from the target when written). No FK: logs outlive deletions.
  offeringId   String?
  /// Department/subject area the entry concerns: the course's, else the actor's (or target user's).
  departmentId String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
  @@index([departmentId, createdAt])
  @@index([offeringId])
}

model Assignment {
  id               String           @id @default(cuid())
  offeringId       String
  offering         CourseOffering   @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  title            String
  instructions     String?
  dueAt            DateTime?
  allowLate        Boolean          @default(true)
  isPublished      Boolean          @default(true)
  checkSimilarity  Boolean          @default(true)
  /// Ignore passages that more than half the class shares (textbook phrasing, copied questions).
  ignoreCommon     Boolean          @default(true)
  reportVisibility ReportVisibility @default(IMMEDIATE)
  /// Question text / starter code every cadet is expected to include; ignored by the similarity check.
  baseText         String?
  createdById      String
  createdBy        User             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  submissions Submission[]
  matches     SimilarityMatch[]
  gradeItem   GradeItem?

  @@index([offeringId])
}

/// A cadet's current submission (resubmitting replaces it).
model Submission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  textAnswer   String?
  /// Analysed text: the answer plus text extracted from files.
  content      String     @default("")
  /// [{ s, e, kind: "text" | "code" | "meta" }] — character ranges of `content`.
  segments     Json       @default("[]")
  version      Int        @default(1)
  isLate       Boolean    @default(false)
  submittedAt  DateTime   @default(now())
  /// Share (0–1) of this submission's tokens that also appear in any other submission. Null = not checked.
  similarity   Float?
  checkedAt    DateTime?

  files    SubmissionFile[]
  matchesA SimilarityMatch[] @relation("MatchA")
  matchesB SimilarityMatch[] @relation("MatchB")

  @@unique([assignmentId, studentId])
}

model SubmissionFile {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  fileName     String
  storageKey   String
  mimeType     String
  sizeBytes    Int
  /// Extracted [{ text, kind }]; null when the file type cannot be analysed.
  extracted    Json?
  createdAt    DateTime   @default(now())

  @@index([submissionId])
}

/// Overlap between two submissions of the same assignment.
model SimilarityMatch {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  aId          String
  a            Submission @relation("MatchA", fields: [aId], references: [id], onDelete: Cascade)
  bId          String
  b            Submission @relation("MatchB", fields: [bId], references: [id], onDelete: Cascade)
  /// Share of A covered by B, and of B covered by A.
  scoreA       Float
  scoreB       Float
  /// [[start, end], …] character ranges in each submission's content.
  spansA       Json
  spansB       Json

  @@unique([aId, bId])
  @@index([assignmentId])
}

/// File bytes, used when STORAGE_DRIVER=db (e.g. on Vercel, which has no persistent disk).
model StoredFile {
  key       String   @id
  data      Bytes
  sizeBytes Int
  createdAt DateTime @default(now())
}

/// A weighted part of the final grade, e.g. "Assignments 40%".
model GradeCategory {
  id         String         @id @default(cuid())
  offeringId String
  offering   CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  name       String
  /// Percent of the final grade.
  weight     Float
  position   Int            @default(0)
  createdAt  DateTime       @default(now())

  items GradeItem[]

  @@index([offeringId])
}

/// One column of the gradebook: an assignment or a standalone item (exam, participation…).
model GradeItem {
  id           String         @id @default(cuid())
  offeringId   String
  offering     CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  categoryId   String?
  category     GradeCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  assignmentId String?        @unique
  assignment   Assignment?    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  quizId       String?        @unique
  quiz         Quiz?          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  title        String
  maxPoints    Float
  /// Cadets only see released items.
  isReleased   Boolean        @default(false)
  position     Int            @default(0)
  createdAt    DateTime       @default(now())

  grades Grade[]

  @@index([offeringId])
}

model Grade {
  id         String    @id @default(cuid())
  itemId     String
  item       GradeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  studentId  String
  student    User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// Null = not graded yet (doesn't count towards the total).
  points     Float?
  feedback   String?
  gradedById String?
  updatedAt  DateTime  @updatedAt

  @@unique([itemId, studentId])
}

enum QuestionType {
  /// One correct option (also used for true/false).
  SINGLE
  /// Several correct options; partial credit.
  MULTIPLE
  /// Auto-graded when it matches an accepted answer, otherwise graded by hand.
  SHORT
  /// Graded by hand (prose or code).
  ESSAY
  /// Code the cadet can run in the exam page (Python, JavaScript, HTML/CSS/JS); graded by hand.
  CODE
}

/// What cadets see after the quiz closes.
enum QuizResults {
  HIDDEN
  SCORE
  FULL
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

model Quiz {
  id               String         @id @default(cuid())
  offeringId       String
  offering         CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  title            String
  instructions     String?
  opensAt          DateTime?
  closesAt         DateTime?
  /// Minutes per attempt; null = until the quiz closes.
  timeLimitMin     Int?
  shuffleQuestions Boolean        @default(true)
  shuffleOptions   Boolean        @default(true)
  isPublished      Boolean        @default(false)
  results          QuizResults    @default(SCORE)
  /// Only allow attempts from Safe Exam Browser.
  requireSeb       Boolean        @default(false)
  /// Exam rooms (academy networks) cadets must be on; none = anywhere.
  networks         ExamNetwork[]
  createdById      String
  createdBy        User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  questions QuizQuestion[]
  attempts  QuizAttempt[]
  gradeItem GradeItem?

  @@index([offeringId])
}

model QuizQuestion {
  id        String       @id @default(cuid())
  quizId    String
  quiz      Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type      QuestionType
  prompt    String
  points    Float
  position  Int          @default(0)
  /// SINGLE/MULTIPLE: [{ id, text, correct }]
  options   Json         @default("[]")
  /// SHORT: accepted answers, compared case-/space-insensitively.
  accepted  Json         @default("[]")
  /// ESSAY: monospace answer box for code.
  codeAnswer Boolean     @default(false)
  /// CODE: "python" | "javascript" | "web" (see lib/code.ts).
  language   String?
  /// CODE: starter files shown to cadets, { [fileName]: content }.
  starter    Json        @default("{}")

  answers QuizAnswer[]

  @@index([quizId])
}

model QuizAttempt {
  id           String        @id @default(cuid())
  quizId       String
  quiz         Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId    String
  student      User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status       AttemptStatus @default(IN_PROGRESS)
  startedAt    DateTime      @default(now())
  /// Server-side deadline: start + time limit, capped at the quiz's close time.
  deadlineAt   DateTime?
  submittedAt  DateTime?
  autoSubmitted Boolean      @default(false)
  /// This attempt's question order and option order: { questions: [id], options: { [qid]: [optId] } }
  layout       Json
  /// Sum of awarded points; null until every answer is graded.
  score        Float?
  maxScore     Float         @default(0)
  ip           String?
  userAgent    String?

  answers QuizAnswer[]
  events  QuizEvent[]

  @@unique([quizId, studentId])
}

model QuizAnswer {
  id         String       @id @default(cuid())
  attemptId  String
  attempt    QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  /// { choice: [optId] }, { text: "…" } or, for CODE, { files: { [fileName]: content } }
  response   Json
  /// Null = needs grading by hand.
  points     Float?
  feedback   String?
  autoGraded Boolean      @default(false)
  gradedById String?
  updatedAt  DateTime     @updatedAt

  @@unique([attemptId, questionId])
  @@index([questionId])
}

/// Integrity log: focus loss, fullscreen exit, copy/paste, resumed from another device…
model QuizEvent {
  id        String      @id @default(cuid())
  attemptId String
  attempt   QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  type      String
  at        DateTime    @default(now())
  details   Json?

  @@index([attemptId])
}

/// Academic unit. Divisions (กองวิชา) have no parent; departments (ภาควิชา) belong to a division.
model Department {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  nameTh    String?
  parentId  String?
  parent    Department?  @relation("DeptTree", fields: [parentId], references: [id], onDelete: Restrict)
  /// Theme colour (#rrggbb). Departments without one use their division's.
  color     String?
  /// Bundled logo under /public (e.g. /logos/mc.webp) …
  logoUrl   String?
  /// … or an uploaded logo (storage key + MIME type); takes precedence.
  logoKey   String?
  logoMime  String?
  children  Department[] @relation("DeptTree")
  position  Int          @default(0)
  createdAt DateTime     @default(now())

  courses Course[]
  users   User[]
}

/// A named exam room / network the admin defines once, e.g. "CS Lab 301: 10.20.3.0/24".
model ExamNetwork {
  id        String   @id @default(cuid())
  name      String
  /// IPs/CIDRs, one per line.
  cidrs     String
  createdAt DateTime @default(now())

  quizzes Quiz[]
}

/// Academy-wide key/value settings (e.g. Safe Exam Browser config keys).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
