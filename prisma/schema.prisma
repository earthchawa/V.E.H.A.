// NKRAFA AI Classroom — data model
// Phase 1: accounts, terms, courses, course offerings, enrollment, materials, audit log.
// Phase 2: assignments, submissions, similarity checking.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum EnrollmentRole {
  STUDENT
  INSTRUCTOR
}

enum MaterialType {
  FILE
  LINK
}

/// When cadets may see the similarity report for their own submission.
enum ReportVisibility {
  IMMEDIATE
  AFTER_DUE
  HIDDEN
}

model User {
  id                    String    @id @default(cuid())
  /// Student ID / staff ID — what people type to log in.
  username              String    @unique
  fullName              String
  /// Optional; required for self-service "forgot password".
  email                 String?   @unique
  role                  Role      @default(STUDENT)
  passwordHash          String
  /// True for initial and admin-reset passwords: user must set their own on next login.
  mustChangePassword    Boolean   @default(true)
  /// A temporary password stops working after this time.
  tempPasswordExpiresAt DateTime?
  failedLoginCount      Int       @default(0)
  lockedUntil           DateTime?
  isActive              Boolean   @default(true)
  lastLoginAt           DateTime?
  passwordChangedAt     DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  sessions    Session[]
  resetTokens PasswordResetToken[]
  enrollments Enrollment[]
  materials   Material[]
  auditLogs   AuditLog[]
  assignments Assignment[]
  submissions Submission[]
}

model Session {
  id        String   @id @default(cuid())
  /// SHA-256 of the cookie token; the raw token is never stored.
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Term {
  id           String    @id @default(cuid())
  /// Buddhist-era academic year, e.g. 2569.
  academicYear Int
  /// 1, 2 or 3 (summer).
  semester     Int
  startDate    DateTime?
  endDate      DateTime?
  isCurrent    Boolean   @default(false)
  createdAt    DateTime  @default(now())

  offerings CourseOffering[]

  @@unique([academicYear, semester])
}

model Course {
  id          String   @id @default(cuid())
  /// e.g. CS201
  code        String   @unique
  title       String
  titleTh     String?
  credits     Int?
  description String?
  createdAt   DateTime @default(now())

  offerings CourseOffering[]
}

/// A course taught in a specific term (and section).
model CourseOffering {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  termId    String
  term      Term     @relation(fields: [termId], references: [id], onDelete: Restrict)
  section   String   @default("1")
  createdAt DateTime @default(now())

  enrollments Enrollment[]
  materials   Material[]
  assignments Assignment[]

  @@unique([courseId, termId, section])
  @@index([termId])
}

model Enrollment {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  offeringId String
  offering   CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  role       EnrollmentRole @default(STUDENT)
  createdAt  DateTime       @default(now())

  @@unique([userId, offeringId])
  @@index([offeringId])
}

model Material {
  id          String         @id @default(cuid())
  offeringId  String
  offering    CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  title       String
  description String?
  /// Optional week number for grouping.
  week        Int?
  type        MaterialType
  // FILE
  fileName    String?
  storageKey  String?
  mimeType    String?
  sizeBytes   Int?
  // LINK
  url         String?
  isPublished Boolean        @default(true)
  createdById String
  createdBy   User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([offeringId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  details    Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}

model Assignment {
  id               String           @id @default(cuid())
  offeringId       String
  offering         CourseOffering   @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  title            String
  instructions     String?
  dueAt            DateTime?
  allowLate        Boolean          @default(true)
  isPublished      Boolean          @default(true)
  checkSimilarity  Boolean          @default(true)
  /// Ignore passages that more than half the class shares (textbook phrasing, copied questions).
  ignoreCommon     Boolean          @default(true)
  reportVisibility ReportVisibility @default(IMMEDIATE)
  /// Question text / starter code every cadet is expected to include; ignored by the similarity check.
  baseText         String?
  createdById      String
  createdBy        User             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  submissions Submission[]
  matches     SimilarityMatch[]

  @@index([offeringId])
}

/// A cadet's current submission (resubmitting replaces it).
model Submission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  textAnswer   String?
  /// Analysed text: the answer plus text extracted from files.
  content      String     @default("")
  /// [{ s, e, kind: "text" | "code" | "meta" }] — character ranges of `content`.
  segments     Json       @default("[]")
  version      Int        @default(1)
  isLate       Boolean    @default(false)
  submittedAt  DateTime   @default(now())
  /// Share (0–1) of this submission's tokens that also appear in any other submission. Null = not checked.
  similarity   Float?
  checkedAt    DateTime?

  files    SubmissionFile[]
  matchesA SimilarityMatch[] @relation("MatchA")
  matchesB SimilarityMatch[] @relation("MatchB")

  @@unique([assignmentId, studentId])
}

model SubmissionFile {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  fileName     String
  storageKey   String
  mimeType     String
  sizeBytes    Int
  /// Extracted [{ text, kind }]; null when the file type cannot be analysed.
  extracted    Json?
  createdAt    DateTime   @default(now())

  @@index([submissionId])
}

/// Overlap between two submissions of the same assignment.
model SimilarityMatch {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  aId          String
  a            Submission @relation("MatchA", fields: [aId], references: [id], onDelete: Cascade)
  bId          String
  b            Submission @relation("MatchB", fields: [bId], references: [id], onDelete: Cascade)
  /// Share of A covered by B, and of B covered by A.
  scoreA       Float
  scoreB       Float
  /// [[start, end], …] character ranges in each submission's content.
  spansA       Json
  spansB       Json

  @@unique([aId, bId])
  @@index([assignmentId])
}

/// File bytes, used when STORAGE_DRIVER=db (e.g. on Vercel, which has no persistent disk).
model StoredFile {
  key       String   @id
  data      Bytes
  sizeBytes Int
  createdAt DateTime @default(now())
}
