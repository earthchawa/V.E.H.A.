# ---- Database (PostgreSQL) ----
DATABASE_URL="postgresql://classroom:classroom@localhost:5432/classroom?schema=public"

# ---- App ----
# Public URL of the site, used to build password-reset links.
APP_URL="http://localhost:3000"
# Where uploaded files are stored (mount a backed-up volume here in production).
UPLOAD_DIR="./storage/uploads"
# Set to "false" ONLY if the site is served over plain HTTP inside the academy network.
COOKIE_SECURE="true"

# ---- Accounts ----
# Days a temporary (initial / admin-reset) password stays valid before it expires.
TEMP_PASSWORD_DAYS=14

# ---- Email for self-service password reset (optional) ----
# If SMTP_HOST is empty, reset links are written to the server log instead of emailed.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="V.E.H.A. <no-reply@example.ac.th>"

# ---- First admin account (used by `npm run db:seed`) ----
SEED_ADMIN_USERNAME="admin"

# ---- Docker Compose only ----
POSTGRES_PASSWORD="change-me"

# ---- Optional services ----
# Vercel Blob file storage (set automatically when a Blob store is connected to the Vercel project).
# With it, new uploads go to Blob (private), straight from the browser, and the 4 MB cap on Vercel goes.
# BLOB_READ_WRITE_TOKEN=""
# AI reference answers for the similarity check (Anthropic API key; each use costs API credit).
# ANTHROPIC_API_KEY=""
# AI_ANSWER_MODEL="claude-opus-5-5"

# ---- Vercel demo only ----
# Direct connection used for migrations (Neon sets this automatically).
# DATABASE_URL_UNPOOLED=""
# DEMO_SEED="true"          # seed demo accounts + sample assignments on each build
# DEMO_PASSWORD=""          # shared first-login password for the demo accounts
# STORAGE_DRIVER="db"       # default on Vercel without a Blob store: keep uploaded files in Postgres
# MAX_UPLOAD_MB=4           # default on Vercel without Blob (functions accept ≤ 4.5 MB per request)
