{
  "name": "veha",
  "version": "0.1.0",
  "private": true,
  "description": "V.E.H.A. (Virtual Educational Hangar for Air-cadets) — NKRAFA online classroom: courses per term, materials, assignments, quizzes, grades",
  "scripts": {
    "predev": "node scripts/copy-pyodide.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-pyodide.mjs",
    "build": "next build",
    "vercel-build": "tsx scripts/vercel-build.ts",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node e2e/run.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed.ts --demo",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/noto-sans-thai": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "codemirror": "^6.0.1",
    "geist": "^1.9.0",
    "mammoth": "^1.13.0",
    "next": "^16.4.5",
    "nodemailer": "^7.0.10",
    "pyodide": "^0.27.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "unpdf": "^2.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
